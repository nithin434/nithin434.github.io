<?xml version="1.0" encoding="utf-8"?>
<browserconfig>
  <msapplication>
    <tile>
      <square70x70logo src="/assets/img/icons/ms-icon-70x70.png"/>
      <square150x150logo src="/assets/img/icons/ms-icon-150x150.png"/>
      <square310x310logo src="/assets/img/icons/ms-icon-310x310.png"/>
      <wide310x150logo src="/assets/img/icons/ms-icon-310x150.png"/>
      <TileColor>#000000</TileColor>
      <TileImage src="/assets/img/icons/ms-icon-144x144.png"/>
    </tile>
    <badge>
      <polling-uri src="/api/badge" />
      <frequency>30</frequency>
    </badge>
    <notification>
      <polling-uri src="/api/notifications" />
      <frequency>60</frequency>
      <cycle>1</cycle>
    </notification>
    <task>
      <name>Portfolio Update</name>
      <uri>/</uri>
    </task>
  </msapplication>
</browserconfig>